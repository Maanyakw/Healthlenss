# Copy to ".env". All keys are optional; without them chat and report use local fallbacks.
GROQ_API_KEY=                  # chat assistant (Groq free tier)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=                # doctor report (Gemini free tier)
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=             # optional; paid. Used for the report only if no Gemini key
ANTHROPIC_MODEL=claude-sonnet-4-5
CHAT_PROVIDER=auto             # auto | groq | gemini | anthropic | none
REPORT_PROVIDER=auto           # auto | gemini | anthropic | groq | none
RISK_BACKEND=auto              # auto | tabpfn | hgb
CORS_ORIGINS=http://localhost:3000
